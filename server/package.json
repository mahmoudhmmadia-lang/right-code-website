{
  "name": "server",
  "version": "1.0.0",
  "description": "Express server with TypeScript",
  "main": "server.ts",
  "scripts": {
    "start": "tsx server.ts",
    "dev": "tsx watch server.ts",
    "build": "esbuild server.ts --bundle --platform=node --outfile=server.js --external:@prisma/client --external:.prisma/client",
    "db:push": "prisma db push",
    "db:clear": "tsx seeders/clear-db.seeder.ts",
    "db:seed": "bun run seed:all",
    "db:reset": "bun run db:clear && bun run db:push && bun run db:seed",
    "migrate": "prisma db push",
    "generate": "prisma generate",
    "studio": "prisma studio",
    "seed": "bun run seed:all",
    "seed:all": "bun run seed:content && bun run seed:pages && bun run seed:routes && bun run seed:home && bun run seed:admin",
    "seed:admin": "tsx seeders/admin.seeder.ts",
    "seed:content": "tsx seeders/content.seeder.ts",
    "seed:home": "tsx seeders/home.seeder.ts",
    "seed:job-applications": "tsx seeders/job-applications.seeder.ts",
    "seed:pages": "tsx seeders/pages.seeder.ts",
    "seed:routes": "tsx seeders/route-sections.seeder.ts",
    "new-module": "./scripts/new-module.sh",
    "init-prisma": "prisma init"
  },
  "keywords": ["express", "typescript", "nodejs"],
  "author": "",
  "license": "ISC",
  "packageManager": "bun@latest",
  "dependencies": {
    "@prisma/client": "6.19.0",
    "bcryptjs": "latest",
    "cookie-parser": "latest",
    "cors": "latest",
    "dotenv": "latest",
    "express": "latest",
    "helmet": "latest",
    "joi": "latest",
    "jsonwebtoken": "latest",
    "morgan": "latest",
    "multer": "latest",
    "nodemailer": "latest",
    "rotating-file-stream": "latest",
    "uuid": "latest"
  },
  "devDependencies": {
    "@types/cookie-parser": "latest",
    "@types/cors": "latest",
    "@types/express": "latest",
    "@types/jsonwebtoken": "latest",
    "@types/morgan": "latest",
    "@types/multer": "latest",
    "@types/nodemailer": "latest",
    "@types/uuid": "latest",
    "esbuild": "latest",
    "prisma": "6.19.0",
    "tsx": "latest",
    "typescript": "latest"
  }
}

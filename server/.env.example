PORT=5000
NODE_ENV=development

# App mode and public URLs
MODE=DEV
DEV_URL=http://localhost:5000
URL=https://example.com
LOCATION_URL=http://localhost:5000
IMAGES_PATH=uploads/images
ASSETS_PATH=assets

# Database
DEV_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/right_code?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/right_code?schema=public

# Auth
SECRET=replace-with-a-long-random-jwt-secret

# Seeded admin account
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
ADMIN_NAME=Right Code Admin

# Gmail SMTP
EMAIL=your-email@gmail.com
PASSWORD=your-gmail-app-password
EMAIL_FORM=your-email@gmail.com

{
  "name": "company",
  "private": true,
  "version": "0.0.0",
  "packageManager": "bun@latest",
  "workspaces": [
    "web",
    "web/server",
    "admin",
    "admin/server",
    "server"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=web --filter=admin-template --filter=server --parallel",
    "dev:web": "turbo run dev --filter=web",
    "dev:admin": "turbo run dev --filter=admin-template",
    "dev:api": "turbo run dev --filter=server",
    "dev:sites": "turbo run dev --filter=web-server --filter=admin-template-server --parallel",
    "build": "turbo run build --filter=web --filter=admin-template",
    "build:all": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "turbo run format",
    "db:push": "turbo run db:push --filter=server",
    "db:clear": "turbo run db:clear --filter=server",
    "db:seed": "turbo run db:seed --filter=server",
    "db:reset": "turbo run db:reset --filter=server",
    "seed": "turbo run seed --filter=server",
    "start:web": "turbo run start --filter=web-server",
    "start:admin": "turbo run start --filter=admin-template-server",
    "start:api": "turbo run start --filter=server",
    "start:sites": "turbo run start --filter=web-server --filter=admin-template-server --parallel"
  },
  "devDependencies": {
    "turbo": "^2.5.8"
  }
}
